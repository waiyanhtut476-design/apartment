{
  "entities": {
    "Invoice": {
      "title": "Invoice",
      "description": "Apartment utility bill invoice record stored for tenants and landlords",
      "type": "object",
      "properties": {
        "room": {
          "type": "string",
          "description": "Room number, e.g. 101, 204"
        },
        "month": {
          "type": "string",
          "description": "Billing month, e.g. 2026-09"
        },
        "tenantName": {
          "type": "string",
          "description": "Name of the tenant"
        },
        "roomRent": {
          "type": "number",
          "description": "Monthly room rental charge"
        },
        "electricity": {
          "type": "object",
          "description": "Electricity meter readings and calculated cost"
        },
        "water": {
          "type": "object",
          "description": "Water meter readings and calculated cost"
        },
        "commonFee": {
          "type": "number",
          "description": "Common facility or sanitation fee"
        },
        "totalAmount": {
          "type": "number",
          "description": "Grand total bill amount"
        },
        "currency": {
          "type": "string",
          "description": "Currency code, e.g. Baht, MMK"
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Paid"],
          "description": "Payment status"
        },
        "notes": {
          "type": "string",
          "description": "Optional landlord remarks or payment instructions"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["room", "month", "totalAmount", "status"]
    },
    "Room": {
      "title": "Room",
      "description": "Apartment room details, occupancy status, and tenant information",
      "type": "object",
      "properties": {
        "roomNumber": {
          "type": "string",
          "description": "Room number"
        },
        "floor": {
          "type": "number",
          "description": "Floor number"
        },
        "roomType": {
          "type": "string",
          "description": "Room type (Studio, 1 Bedroom, etc.)"
        },
        "monthlyRent": {
          "type": "number",
          "description": "Monthly rental price"
        },
        "currency": {
          "type": "string",
          "description": "Currency symbol or code"
        },
        "status": {
          "type": "string",
          "enum": ["available", "occupied", "maintenance"],
          "description": "Occupancy status"
        },
        "tenantName": {
          "type": "string",
          "description": "Tenant name if occupied"
        },
        "tenantPhone": {
          "type": "string",
          "description": "Tenant phone number"
        },
        "notes": {
          "type": "string",
          "description": "Room condition or notes"
        }
      },
      "required": ["roomNumber", "floor", "roomType", "monthlyRent", "status"]
    }
  },
  "firestore": {
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Collection of utility bill invoices generated by the apartment calculator"
    },
    "/rooms/{roomId}": {
      "schema": "Room",
      "description": "Collection of apartment rooms and their occupancy status"
    }
  }
}
