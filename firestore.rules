rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection path
    match /test/{docId} {
      allow read, write: if true;
    }

    // Invoices Collection Rules
    match /invoices/{invoiceId} {
      allow read: if true;
      allow create, update: if request.resource.data.room is string
        && request.resource.data.month is string
        && request.resource.data.totalAmount is number;
      allow delete: if true;
    }

    // Rooms Collection Rules
    match /rooms/{roomId} {
      allow read: if true;
      allow create, update: if request.resource.data.roomNumber is string
        && request.resource.data.status in ['available', 'occupied', 'maintenance'];
      allow delete: if true;
    }
  }
}
