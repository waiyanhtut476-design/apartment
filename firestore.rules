rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny for unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check & connection test path
    match /test/{docId} {
      allow read, write: if true;
    }

    // Invoices collection for utility bills
    match /invoices/{invoiceId} {
      allow read: if true;
      allow write: if true;
    }

    // Rooms collection for apartment room management
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
